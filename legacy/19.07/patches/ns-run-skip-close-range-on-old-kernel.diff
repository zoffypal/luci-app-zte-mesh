+/* close_range(2) exists since Linux 5.9. On an older kernel the syscall is
+ * not there at all, and trying it on every start leaves a "syscall 436"
+ * audit line in the log for nothing, so ask uname() first and go straight to
+ * the per-descriptor loop when the kernel predates it. An unparsable release
+ * string, or a failed uname(), means "try it and see" rather than "assume
+ * it is old": the ENOSYS fallback in close_inherited_fds() still covers a
+ * kernel that claims to be new enough but refuses the call (seccomp, or a
+ * build that dropped it). */
+static int kernel_has_close_range(void)
+{
+    struct utsname name;
+    unsigned long major, minor;
+    if (uname(&name) != 0)
+        return 1;
+    if (sscanf(name.release, "%lu.%lu", &major, &minor) != 2)
+        return 1;
+    return major > 5 || (major == 5 && minor >= 9);
+}
+
